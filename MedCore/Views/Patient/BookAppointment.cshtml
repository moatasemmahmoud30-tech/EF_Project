@model MedCore.ViewModels.BookAppointmentViewModel

@{
    ViewData["Title"] = "Book Appointment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-[#f8fafc] py-12 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-3xl mx-auto">
        
        <div class="mb-8">
            <a asp-action="Dashboard" class="inline-flex items-center text-sm font-medium text-slate-500 hover:text-blue-600 transition-colors mb-4">
                <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Back to Dashboard
            </a>
            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Select a Time</h1>
            <p class="mt-2 text-sm text-slate-500">Booking an appointment with <span class="font-bold text-slate-700">Dr. @Model.DoctorName</span> for <span class="font-bold text-slate-700">@Model.RequestedDate.ToString("dddd, MMMM dd, yyyy")</span>.</p>
        </div>

        <div class="bg-white rounded-2xl shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-slate-200 overflow-hidden">
            <form asp-action="ConfirmBooking" method="post" class="p-6 sm:p-8">
                @Html.AntiForgeryToken()
                
                <input type="hidden" asp-for="DoctorId" />
                <input type="hidden" asp-for="DoctorName" />
                <input type="hidden" asp-for="RequestedDate" />

                <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-6 p-4 bg-red-50 rounded-xl border border-red-100 font-medium animate-fade-in-down"></div>

                <h3 class="text-lg font-bold text-slate-900 mb-4">Available Slots</h3>

                @if (Model.AvailableTimeSlots == null || !Model.AvailableTimeSlots.Any())
                {
                    <div class="text-center py-12 border-2 border-dashed border-slate-200 rounded-xl bg-slate-50">
                        <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <h3 class="mt-2 text-sm font-bold text-slate-900">No availability</h3>
                        <p class="mt-1 text-sm text-slate-500">Dr. @Model.DoctorName is fully booked or not working on this date.</p>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 mb-8">
                        @foreach (var slot in Model.AvailableTimeSlots)
                        {
                            string timeString = DateTime.Today.Add(slot).ToString("hh:mm tt");
                            string inputId = $"slot_{slot.Hours}_{slot.Minutes}";

                            <div class="relative">
                                <input type="radio" asp-for="SelectedTimeSlot" value="@slot" id="@inputId" class="peer sr-only" required />
                                
                                <label for="@inputId" class="flex items-center justify-center py-3 px-4 border border-slate-200 rounded-xl shadow-sm text-sm font-bold text-slate-700 bg-white cursor-pointer transition-all hover:bg-slate-50 peer-checked:border-blue-600 peer-checked:bg-blue-50 peer-checked:text-blue-700 peer-checked:ring-1 peer-checked:ring-blue-600">
                                    @timeString
                                </label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="SelectedTimeSlot" class="text-xs text-red-500 block mb-6"></span>

                    <div class="pt-4 border-t border-slate-100">
                        <button type="submit" class="w-full sm:w-auto sm:ml-auto flex justify-center py-3.5 px-8 border border-transparent rounded-xl shadow-md text-sm font-bold text-white bg-[#0090FF] hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                            Confirm Appointment
                        </button>
                    </div>
                }
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}