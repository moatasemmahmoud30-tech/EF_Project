@model IEnumerable<EF_Project.Models.Appointment>
@using EF_Project.Models

@{
    ViewData["Title"] = "My Medical Records";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var upcomingAppointments = Model.Where(a => a.AppointmentDate >= DateTime.Today).ToList();
    var pastAppointments = Model.Where(a => a.AppointmentDate < DateTime.Today).ToList();
}

<div class="min-h-screen bg-[#f8fafc] py-12 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-5xl mx-auto">
        
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-8 rounded-xl bg-green-50 border border-green-200 p-4 flex items-center gap-3 shadow-sm animate-fade-in-down">
                <div class="flex-shrink-0 text-green-500">
                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-green-800">
                        @TempData["SuccessMessage"]
                    </p>
                </div>
            </div>
        }

        <div class="mb-10">
            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Medical Records</h1>
            <p class="mt-2 text-sm text-slate-500">Manage your upcoming visits and review past consultation notes.</p>
        </div>

        <div class="space-y-12">
            
            <section>
                <h2 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                    Upcoming Appointments
                </h2>
                
                @if (!upcomingAppointments.Any())
                {
                    <div class="p-8 text-center border-2 border-dashed border-slate-200 rounded-2xl bg-slate-50">
                        <p class="text-sm font-medium text-slate-500">You have no upcoming appointments.</p>
                        <a asp-action="FindDoctor" class="mt-3 inline-block text-sm font-bold text-blue-600 hover:text-blue-500">Book a new appointment &rarr;</a>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        @foreach (var appt in upcomingAppointments)
                        {
                            <div class="bg-white rounded-2xl shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-blue-100 p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                                <div>
                                    <div class="text-xs font-bold text-blue-600 tracking-wider uppercase mb-1">
                                        @appt.AppointmentDate.ToString("dddd, MMM dd, yyyy")
                                    </div>
                                    <h3 class="text-base font-bold text-slate-900">Dr. @appt.Doctor?.ApplicationUser?.FullName</h3>
                                    <p class="text-sm text-slate-500 mt-0.5">@appt.Doctor?.Speciality?.Name</p>
                                </div>
                                <div class="bg-blue-50 text-blue-700 px-4 py-2 rounded-xl text-sm font-bold text-center min-w-[100px]">
                                    @appt.AppointmentDate.ToString("hh:mm tt")
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <section>
                <h2 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-slate-300"></span>
                    Past Consultations
                </h2>

                @if (!pastAppointments.Any())
                {
                    <div class="p-8 text-center border border-slate-200 rounded-2xl bg-white">
                        <p class="text-sm font-medium text-slate-500">Your consultation history is empty.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-4">
                        @foreach (var appt in pastAppointments)
                        {
                            <div class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 transition-colors hover:border-slate-300">
                                
                                <div class="flex items-start gap-4">
                                    <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 flex-shrink-0">
                                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="text-base font-bold text-slate-900">Dr. @appt.Doctor?.ApplicationUser?.FullName</h3>
                                        <p class="text-sm text-slate-500 mt-0.5">@appt.AppointmentDate.ToString("MMMM dd, yyyy") at @appt.AppointmentDate.ToString("hh:mm tt")</p>
                                        
                                        @if (appt.Prescriptions != null && appt.Prescriptions.Any())
                                        {
                                            <div class="mt-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-green-50 text-green-700 border border-green-100">
                                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                </svg>
                                                Prescription Issued
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="mt-3 block text-xs font-medium text-slate-400">No prescription recorded</span>
                                        }
                                    </div>
                                </div>
                                
                                @if (appt.Prescriptions != null && appt.Prescriptions.Any())
                                {
                                    <button type="button" class="w-full md:w-auto px-4 py-2 border border-slate-200 rounded-xl shadow-sm text-sm font-bold text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-200 transition-colors">
                                        View Details
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </section>
            
        </div>
    </div>
</div>