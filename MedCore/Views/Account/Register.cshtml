@model MedCore.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Join MedCore";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen flex flex-col items-center justify-center bg-[#f8fafc] py-12 px-4 sm:px-6 lg:px-8 font-sans">
    
    <div class="max-w-3xl w-full">
        <div class="bg-blue-50/50 border border-blue-100 rounded-2xl p-6 mb-6 flex items-center gap-4">
            <div class="w-12 h-12 bg-white rounded-xl shadow-sm flex items-center justify-center text-blue-500">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
            </div>
            <div>
                <h2 class="text-2xl font-bold tracking-tight text-slate-900">Join MedCore</h2>
                <p class="text-sm text-slate-500 mt-1">Create your account to get started with smart healthcare.</p>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
            <button type="button" id="tab-patient" onclick="switchRole('Patient')"
                    class="role-tab text-left p-5 rounded-2xl border-2 transition-all duration-200 border-blue-400 bg-blue-50/30 shadow-sm relative overflow-hidden focus:outline-none">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-600">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                    </div>
                    <div>
                        <div class="font-semibold text-slate-900 text-sm">Patient</div>
                        <div class="text-xs text-slate-500 mt-0.5">Books appointments & manage health</div>
                    </div>
                </div>
            </button>

            <button type="button" id="tab-doctor" onclick="switchRole('Doctor')"
                    class="role-tab text-left p-5 rounded-2xl border-2 transition-all duration-200 border-slate-200 bg-white opacity-80 hover:opacity-100 hover:border-slate-300 focus:outline-none">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                        </svg>
                    </div>
                    <div>
                        <div class="font-semibold text-slate-900 text-sm">Doctor</div>
                        <div class="text-xs text-slate-500 mt-0.5">Manage schedule & consultations</div>
                    </div>
                </div>
            </button>
        </div>

        <div class="bg-white p-8 rounded-2xl shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-slate-100">
            <form asp-action="Register" method="post" class="space-y-5">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4"></div>

                <input type="hidden" asp-for="Role" id="RoleInput" value="Patient" />

                <div>
                    <label asp-for="NationalId" class="block text-sm font-semibold text-slate-700 mb-1.5">National ID</label>
                    <input asp-for="NationalId" class="block w-full rounded-xl border-slate-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-2.5 px-4 border" placeholder="e.g. 29801054321" />
                    <span asp-validation-for="NationalId" class="text-xs text-red-500 mt-1"></span>
                </div>

                <div>
                    <label asp-for="FullName" class="block text-sm font-semibold text-slate-700 mb-1.5">Full Name</label>
                    <input asp-for="FullName" class="block w-full rounded-xl border-slate-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-2.5 px-4 border" placeholder="Enter full name" />
                    <span asp-validation-for="FullName" class="text-xs text-red-500 mt-1"></span>
                </div>

                <div>
                    <label asp-for="DateOfBirth" class="block text-sm font-semibold text-slate-700 mb-1.5">Date of Birth</label>
                    <input asp-for="DateOfBirth" type="date" class="block w-full rounded-xl border-slate-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-2.5 px-4 border text-slate-600" />
                    <span asp-validation-for="DateOfBirth" class="text-xs text-red-500 mt-1"></span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="Email" class="block text-sm font-semibold text-slate-700 mb-1.5">Email</label>
                        <input asp-for="Email" class="block w-full rounded-xl border-slate-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-2.5 px-4 border" placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="text-xs text-red-500 mt-1"></span>
                    </div>

                    <div>
                        <label asp-for="Password" class="block text-sm font-semibold text-slate-700 mb-1.5">Password</label>
                        <input asp-for="Password" class="block w-full rounded-xl border-slate-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-2.5 px-4 border" placeholder="Enter password" />
                        <span asp-validation-for="Password" class="text-xs text-red-500 mt-1"></span>
                    </div>
                </div>

                <div id="patient-fields" class="space-y-5 pt-4 block transition-opacity duration-300">
                    <div>
                        <label asp-for="BloodType" class="block text-sm font-semibold text-slate-700 mb-1.5">Blood Type</label>
                        <select asp-for="BloodType" class="block w-full rounded-xl border-slate-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-2.5 px-4 border bg-white text-slate-600">
                            <option value="">Select blood type</option>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                        </select>
                    </div>

                    <div>
                        <label asp-for="Allergies" class="block text-sm font-semibold text-slate-700 mb-1.5">Allergies</label>
                        <textarea asp-for="Allergies" rows="2" class="block w-full rounded-xl border-slate-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-2.5 px-4 border placeholder-slate-400" placeholder="List any known allergies (optional)"></textarea>
                    </div>

                    <div>
                        <label asp-for="ChronicConditions" class="block text-sm font-semibold text-slate-700 mb-1.5">Chronic Conditions</label>
                        <textarea asp-for="ChronicConditions" rows="2" class="block w-full rounded-xl border-slate-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-2.5 px-4 border placeholder-slate-400" placeholder="E.g., Type 2 Diabetes, Hypertension (optional)"></textarea>
                    </div>
                </div>

                <div id="doctor-fields" class="space-y-5 pt-4 hidden transition-opacity duration-300">
                    <h3 class="text-md font-bold text-slate-900 border-b border-slate-100 pb-2">Professional Details</h3>
                    
                    <div>
                        <label asp-for="SpecialityId" class="block text-sm font-semibold text-slate-700 mb-1.5">Specialty</label>
                        <select asp-for="SpecialityId" class="block w-full rounded-xl border-slate-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-2.5 px-4 border bg-white text-slate-600">
                            <option value="">Select specialty</option>
                            <option value="1">Cardiology</option>
                            <option value="2">Neurology</option>
                            <option value="3">Orthopedics</option>
                            <option value="4">Pediatrics</option>
                        </select>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label asp-for="LicenseNumber" class="block text-sm font-semibold text-slate-700 mb-1.5">License Number</label>
                            <input asp-for="LicenseNumber" class="block w-full rounded-xl border-slate-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-2.5 px-4 border placeholder-slate-400" placeholder="CRD-2026-..." />
                        </div>

                        <div>
                            <label asp-for="YearsOfExperience" class="block text-sm font-semibold text-slate-700 mb-1.5">Years of Experience</label>
                            <input asp-for="YearsOfExperience" type="number" class="block w-full rounded-xl border-slate-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-2.5 px-4 border" />
                        </div>
                    </div>

                    <div>
                        <label asp-for="HourlyRate" class="block text-sm font-semibold text-slate-700 mb-1.5">Hourly Rate ($)</label>
                        <input asp-for="HourlyRate" type="number" step="0.01" class="block w-full rounded-xl border-slate-200 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm py-2.5 px-4 border placeholder-slate-400" placeholder="250.00" />
                    </div>
                </div>

                <div class="pt-2">
                    <button type="submit" id="submit-btn" class="w-full flex justify-center py-3.5 px-4 border border-transparent rounded-xl shadow-md text-sm font-bold text-white bg-[#0090FF] hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                        Register as Patient
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function switchRole(role) {
            document.getElementById('RoleInput').value = role;
            document.getElementById('submit-btn').innerText = 'Register as ' + role;

            const patientFields = document.getElementById('patient-fields');
            const doctorFields = document.getElementById('doctor-fields');
            const tabPatient = document.getElementById('tab-patient');
            const tabDoctor = document.getElementById('tab-doctor');

            const activeClasses = ['border-blue-400', 'bg-blue-50/30'];
            const activeIconBg = ['bg-blue-100', 'text-blue-600'];
            
            const inactiveClasses = ['border-slate-200', 'bg-white', 'opacity-80'];
            const inactiveIconBg = ['bg-slate-100', 'text-slate-500'];

            const pIcon = tabPatient.querySelector('div > div:first-child');
            const dIcon = tabDoctor.querySelector('div > div:first-child');

            if (role === 'Patient') {
                patientFields.classList.remove('hidden');
                doctorFields.classList.add('hidden');

                tabPatient.classList.remove(...inactiveClasses);
                tabPatient.classList.add(...activeClasses);
                pIcon.classList.remove(...inactiveIconBg);
                pIcon.classList.add(...activeIconBg);
                
                tabDoctor.classList.remove(...activeClasses);
                tabDoctor.classList.add(...inactiveClasses);
                dIcon.classList.remove(...activeIconBg);
                dIcon.classList.add(...inactiveIconBg);
            } else {
                doctorFields.classList.remove('hidden');
                patientFields.classList.add('hidden');

                tabDoctor.classList.remove(...inactiveClasses);
                tabDoctor.classList.add(...activeClasses);
                dIcon.classList.remove(...inactiveIconBg);
                dIcon.classList.add(...activeIconBg);
                
                tabPatient.classList.remove(...activeClasses);
                tabPatient.classList.add(...inactiveClasses);
                pIcon.classList.remove(...activeIconBg);
                pIcon.classList.add(...inactiveIconBg);
            }
        }
    </script>
}