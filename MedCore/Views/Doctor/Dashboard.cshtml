@{
    ViewData["Title"] = "Doctor Dashboard";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<div class="min-h-screen bg-[#f8fafc] py-8 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-7xl mx-auto">
        
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-8 rounded-xl bg-green-50 border border-green-200 p-4 flex items-center gap-3 shadow-sm animate-fade-in-down">
                <div class="flex-shrink-0 text-green-500">
                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm font-semibold text-green-800">
                        @TempData["SuccessMessage"]
                    </p>
                </div>
            </div>
        }

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
                <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Overview</h1>
                <p class="mt-1 text-sm text-slate-500">Welcome to your daily workspace.</p>
            </div>
            <div class="flex gap-3">
                <a asp-action="Schedule" class="inline-flex items-center justify-center px-4 py-2 border border-slate-200 rounded-xl shadow-sm text-sm font-bold text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                    Edit Schedule
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <div class="lg:col-span-2 space-y-6">
                <div class="bg-white rounded-2xl shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-slate-200 p-6">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-lg font-bold text-slate-900">Today's Appointments</h2>
                        <span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-bold text-blue-700 ring-1 ring-inset ring-blue-700/10">
                            0 Scheduled
                        </span>
                    </div>
                    
                    <div class="text-center py-12 border-2 border-dashed border-slate-200 rounded-xl bg-slate-50">
                        <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <h3 class="mt-2 text-sm font-bold text-slate-900">No appointments today</h3>
                        <p class="mt-1 text-sm text-slate-500">Your schedule is currently clear. Patients will appear here once they book.</p>
                    </div>
                </div>
            </div>

            <div class="space-y-6">
                <div class="bg-white rounded-2xl shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] border border-slate-200 p-6">
                    <h2 class="text-lg font-bold text-slate-900 mb-4">Quick Stats</h2>
                    <dl class="space-y-4">
                        <div class="flex justify-between items-center pb-4 border-b border-slate-100">
                            <dt class="text-sm font-medium text-slate-500">Total Patients</dt>
                            <dd class="text-lg font-bold text-slate-900">0</dd>
                        </div>
                        <div class="flex justify-between items-center pb-4 border-b border-slate-100">
                            <dt class="text-sm font-medium text-slate-500">Consultations</dt>
                            <dd class="text-lg font-bold text-slate-900">0</dd>
                        </div>
                    </dl>
                </div>
            </div>
            
        </div>
    </div>
</div>